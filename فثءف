<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1a1b2e">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>🎮 GameZone - الألعاب الجماعية</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #1a1b2e;
            --secondary: #2d3047;
            --accent: #00b4d8;
            --accent-light: #90e0ef;
            --accent-dark: #0077b6;
            --success: #38b000;
            --warning: #ff9e00;
            --danger: #e63946;
            --light: #f8f9fa;
            --dark: #0d0e1a;
            --gray: #8d99ae;
            
            --radius: 20px;
            --radius-sm: 12px;
            --radius-lg: 30px;
            
            --shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.4);
            --shadow-sm: 0 4px 16px rgba(0, 0, 0, 0.2);
            
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-fast: all 0.15s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: var(--light);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            line-height: 1.6;
            position: relative;
            overflow-x: hidden;
            touch-action: manipulation;
        }

        /* تحسينات للألوان على الموبايل */
        .mobile-color-fix {
            -webkit-backface-visibility: hidden;
            -webkit-transform: translateZ(0) scale(1.0, 1.0);
            transform: translateZ(0);
        }

        .background-animation {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 80%, rgba(0, 180, 216, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(56, 176, 0, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 40% 40%, rgba(230, 57, 70, 0.05) 0%, transparent 50%);
            z-index: -1;
            animation: backgroundShift 20s ease-in-out infinite;
        }

        @keyframes backgroundShift {
            0%, 100% { transform: scale(1) rotate(0deg); }
            50% { transform: scale(1.1) rotate(180deg); }
        }

        .container {
            max-width: 1200px;
            width: 100%;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            border-radius: var(--radius-lg);
            padding: 40px;
            box-shadow: var(--shadow-lg);
            margin-top: 20px;
            transition: var(--transition);
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent), var(--success), var(--warning));
            animation: borderGlow 3s ease-in-out infinite;
        }

        @keyframes borderGlow {
            0%, 100% { opacity: 0.7; }
            50% { opacity: 1; }
        }

        header {
            text-align: center;
            margin-bottom: 40px;
            animation: fadeInUp 1s ease;
        }

        .logo {
            font-size: 5rem;
            margin-bottom: 20px;
            display: block;
            animation: bounce 2s infinite, glow 3s ease-in-out infinite;
            filter: drop-shadow(0 0 20px rgba(0, 180, 216, 0.5));
        }

        @keyframes glow {
            0%, 100% { filter: drop-shadow(0 0 20px rgba(0, 180, 216, 0.5)); }
            50% { filter: drop-shadow(0 0 30px rgba(0, 180, 216, 0.8)); }
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        h1 {
            font-size: 3.5rem;
            margin-bottom: 15px;
            background: linear-gradient(135deg, var(--accent), var(--accent-light), var(--success));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 4px 20px rgba(0, 180, 216, 0.3);
            animation: textShine 3s ease-in-out infinite;
        }

        @keyframes textShine {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .subtitle {
            font-size: 1.4rem;
            opacity: 0.9;
            margin-bottom: 20px;
            color: var(--accent-light);
        }

        /* الكروت */
        .card {
            background: linear-gradient(135deg, 
                rgba(255, 255, 255, 0.1), 
                rgba(255, 255, 255, 0.05));
            border-radius: var(--radius);
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: var(--shadow);
            transition: var(--transition);
            animation: slideUp 0.6s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, 
                transparent, 
                rgba(255, 255, 255, 0.1), 
                transparent);
            transition: var(--transition);
        }

        .card:hover::before {
            left: 100%;
        }

        @keyframes slideUp {
            from { 
                opacity: 0; 
                transform: translateY(30px); 
            }
            to { 
                opacity: 1; 
                transform: translateY(0); 
            }
        }

        @keyframes fadeInUp {
            from { 
                opacity: 0; 
                transform: translateY(20px); 
            }
            to { 
                opacity: 1; 
                transform: translateY(0); 
            }
        }

        /* كرت الترحيب */
        .welcome-card {
            text-align: center;
            padding: 50px 40px;
        }

        .welcome-card h2 {
            font-size: 2.5rem;
            margin-bottom: 30px;
            color: var(--light);
        }

        .features {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 40px;
            flex-wrap: wrap;
        }

        .feature {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: var(--radius);
            transition: var(--transition);
        }

        .feature:hover {
            transform: translateY(-5px);
            background: rgba(255, 255, 255, 0.1);
        }

        .feature i {
            font-size: 2rem;
            color: var(--accent);
        }

        /* الأزرار */
        .glow-button {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: white;
            border: none;
            padding: 18px 40px;
            border-radius: var(--radius);
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(0, 180, 216, 0.3);
        }

        .glow-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, 
                transparent, 
                rgba(255, 255, 255, 0.3), 
                transparent);
            transition: var(--transition);
        }

        .glow-button:hover::before {
            left: 100%;
        }

        .glow-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(0, 180, 216, 0.5);
        }

        /* معلومات اللاعب */
        .player-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(135deg, 
                rgba(255, 255, 255, 0.1), 
                rgba(255, 255, 255, 0.05));
            padding: 25px;
            border-radius: var(--radius);
            margin-bottom: 30px;
            animation: slideUp 0.6s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .player-details {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .player-avatar {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: var(--shadow);
        }

        .player-text {
            display: flex;
            flex-direction: column;
        }

        .player-name {
            font-weight: bold;
            font-size: 1.5rem;
            margin-bottom: 5px;
        }

        .player-id {
            color: var(--accent);
            font-weight: bold;
            font-size: 1.1rem;
        }

        .icon-button {
            background: rgba(255, 255, 255, 0.1);
            color: var(--light);
            border: none;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .icon-button:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: rotate(90deg);
        }

        /* خيارات البحث */
        .search-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .option-card {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid transparent;
            border-radius: var(--radius);
            padding: 25px;
            cursor: pointer;
            transition: var(--transition);
            text-align: center;
        }

        .option-card.active {
            border-color: var(--accent);
            background: rgba(0, 180, 216, 0.1);
            transform: translateY(-5px);
            box-shadow: var(--shadow);
        }

        .option-card:hover:not(.active) {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }

        .option-icon {
            font-size: 3rem;
            margin-bottom: 15px;
            color: var(--accent);
        }

        .option-card.active .option-icon {
            animation: bounce 2s infinite;
        }

        .option-text h3 {
            font-size: 1.3rem;
            margin-bottom: 8px;
            color: var(--light);
        }

        .option-text p {
            color: var(--gray);
            font-size: 0.9rem;
        }

        /* محتوى البحث */
        .search-content {
            display: none;
        }

        .search-content.active {
            display: block;
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .input-with-button {
            display: flex;
            gap: 10px;
        }

        .input-with-button input {
            flex: 1;
            background: rgba(255, 255, 255, 0.1);
            color: var(--light);
            border: 2px solid transparent;
            border-radius: var(--radius);
            padding: 15px;
            font-size: 1rem;
            transition: var(--transition);
        }

        .input-with-button input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.3);
        }

        .search-button {
            background: linear-gradient(135deg, var(--success), #2d7d46);
            color: white;
            border: none;
            padding: 0 25px;
            border-radius: var(--radius);
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
        }

        .search-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(56, 176, 0, 0.3);
        }

        .quick-actions {
            margin-top: 25px;
            padding-top: 25px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .quick-buttons {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .quick-btn {
            background: rgba(255, 255, 255, 0.1);
            color: var(--light);
            border: none;
            padding: 10px 15px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.9rem;
        }

        .quick-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        .styled-select {
            background: rgba(255, 255, 255, 0.1);
            color: var(--light);
            border: 2px solid transparent;
            border-radius: var(--radius);
            padding: 15px;
            font-size: 1rem;
            transition: var(--transition);
            cursor: pointer;
            width: 100%;
        }

        .styled-select:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.3);
        }

        .ai-button {
            background: linear-gradient(135deg, var(--warning), #cc7a00);
            color: white;
            border: none;
            padding: 18px 30px;
            border-radius: var(--radius);
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: var(--transition);
            width: 100%;
            margin-top: 15px;
        }

        .ai-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(255, 158, 0, 0.3);
        }

        /* عرض الخصم */
        .opponent-display {
            display: flex;
            align-items: center;
            gap: 20px;
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: var(--radius);
            margin-bottom: 30px;
            border-left: 4px solid var(--accent);
        }

        .opponent-avatar {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--success), #2d7d46);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
        }

        .opponent-info {
            display: flex;
            flex-direction: column;
        }

        .opponent-name {
            font-weight: bold;
            font-size: 1.3rem;
            margin-bottom: 5px;
        }

        .game-mode {
            color: var(--gray);
            font-size: 0.9rem;
        }

        /* شبكة الألعاب */
        .games-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
        }

        .game-card {
            background: rgba(255, 255, 255, 0.05);
            border-radius: var(--radius);
            padding: 25px;
            cursor: pointer;
            transition: var(--transition);
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .game-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent), var(--success));
        }

        .game-card:hover {
            transform: translateY(-8px);
            border-color: var(--accent);
            box-shadow: var(--shadow-lg);
        }

        .game-icon {
            font-size: 3rem;
            margin-bottom: 15px;
            color: var(--accent);
        }

        .game-info h3 {
            font-size: 1.4rem;
            margin-bottom: 10px;
            color: var(--light);
        }

        .game-info p {
            color: var(--gray);
            margin-bottom: 15px;
            font-size: 0.95rem;
        }

        .game-stats {
            display: flex;
            gap: 15px;
            font-size: 0.85rem;
            color: var(--accent-light);
        }

        .play-button {
            position: absolute;
            top: 25px;
            left: 25px;
            width: 40px;
            height: 40px;
            background: var(--accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            opacity: 0;
            transform: scale(0.8);
            transition: var(--transition);
        }

        .game-card:hover .play-button {
            opacity: 1;
            transform: scale(1);
        }

        /* المودال */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(13, 14, 26, 0.9);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 20px;
            animation: fadeIn 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .modal-content {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            padding: 40px;
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 500px;
            box-shadow: var(--shadow-lg);
            animation: modalSlideUp 0.4s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
        }

        @keyframes modalSlideUp {
            from { 
                opacity: 0; 
                transform: translateY(50px) scale(0.9); 
            }
            to { 
                opacity: 1; 
                transform: translateY(0) scale(1); 
            }
        }

        .modal-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .modal-header h2 {
            font-size: 2rem;
            color: var(--light);
        }

        .players-display {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .player-side {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            flex: 1;
        }

        .player-avatar.you {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
        }

        .player-avatar.opponent {
            background: linear-gradient(135deg, var(--warning), #cc7a00);
        }

        .player-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: var(--shadow);
        }

        .player-label {
            font-size: 0.9rem;
            color: var(--gray);
        }

        .player-name {
            font-weight: bold;
            font-size: 1.1rem;
        }

        .vs-circle {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--danger), #c1121f);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.2rem;
            box-shadow: var(--shadow);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .game-info-modal {
            display: flex;
            align-items: center;
            gap: 20px;
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: var(--radius);
            margin-bottom: 30px;
        }

        .game-icon-modal {
            font-size: 3rem;
            color: var(--accent);
        }

        .game-details h3 {
            font-size: 1.4rem;
            margin-bottom: 5px;
            color: var(--light);
        }

        .game-details p {
            color: var(--gray);
        }

        .modal-actions {
            display: flex;
            gap: 15px;
        }

        .confirm-button {
            flex: 2;
            background: linear-gradient(135deg, var(--success), #2d7d46);
            color: white;
            border: none;
            padding: 18px;
            border-radius: var(--radius);
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: var(--transition);
        }

        .confirm-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(56, 176, 0, 0.3);
        }

        .cancel-button {
            flex: 1;
            background: rgba(255, 255, 255, 0.1);
            color: var(--light);
            border: none;
            padding: 18px;
            border-radius: var(--radius);
            font-size: 1.1rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .cancel-button:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* الإشعارات */
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: linear-gradient(135deg, var(--secondary), var(--primary));
            color: white;
            padding: 20px 25px;
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
            z-index: 1001;
            display: flex;
            align-items: center;
            gap: 15px;
            max-width: 400px;
            animation: notificationSlideIn 0.5s ease, notificationSlideOut 0.5s ease 4.5s forwards;
            border-left: 4px solid var(--accent);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        @keyframes notificationSlideIn {
            from { 
                transform: translateX(100%); 
                opacity: 0; 
            }
            to { 
                transform: translateX(0); 
                opacity: 1; 
            }
        }

        @keyframes notificationSlideOut {
            from { 
                transform: translateX(0); 
                opacity: 1; 
            }
            to { 
                transform: translateX(100%); 
                opacity: 0; 
            }
        }

        .notification-icon {
            font-size: 1.5rem;
        }

        .notification-content {
            flex: 1;
        }

        .notification-title {
            font-weight: bold;
            font-size: 1.1rem;
            margin-bottom: 5px;
        }

        .notification-message {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .notification-close {
            background: none;
            border: none;
            color: var(--gray);
            cursor: pointer;
            font-size: 1.1rem;
            transition: var(--transition);
            padding: 5px;
        }

        .notification-close:hover {
            color: var(--light);
        }

        /* حقوق الملكية */
        .copyright {
            text-align: center;
            margin-top: 40px;
            padding-top: 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 0.9rem;
            opacity: 0.7;
            color: var(--accent-light);
        }

        /* الحالات المخفية */
        .hidden {
            display: none !important;
        }

        /* حقول الإدخال */
        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 10px;
            font-weight: bold;
            color: var(--light);
        }

        .form-group input {
            width: 100%;
            background: rgba(255, 255, 255, 0.1);
            color: var(--light);
            border: 2px solid transparent;
            border-radius: var(--radius);
            padding: 15px;
            font-size: 1rem;
            transition: var(--transition);
        }

        .form-group input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(0, 180, 216, 0.3);
        }

        .form-group input::placeholder {
            color: var(--gray);
        }

        /* التحميل */
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: var(--accent);
            animation: spin 1s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* أقسام الألعاب */
        .game-container {
            background: linear-gradient(135deg, 
                rgba(255, 255, 255, 0.1), 
                rgba(255, 255, 255, 0.05));
            border-radius: var(--radius);
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: var(--shadow);
            animation: slideUp 0.6s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .game-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .game-header h2 {
            font-size: 2rem;
            color: var(--light);
        }

        .back-button {
            background: rgba(255, 255, 255, 0.1);
            color: var(--light);
            border: none;
            padding: 12px 20px;
            border-radius: var(--radius);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .back-button:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        /* لعبة إكس أو */
        .tictactoe-board {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            max-width: 400px;
            margin: 0 auto 30px;
        }

        .tictactoe-cell {
            aspect-ratio: 1;
            background: rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .tictactoe-cell:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .tictactoe-cell.x {
            color: var(--accent);
        }

        .tictactoe-cell.o {
            color: var(--warning);
        }

        .game-info {
            text-align: center;
            margin-bottom: 20px;
        }

        .player-turn {
            font-size: 1.3rem;
            font-weight: bold;
            margin-bottom: 20px;
            color: var(--accent);
        }

        .reset-button {
            background: linear-gradient(135deg, var(--danger), #c1121f);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: var(--radius);
            font-size: 1.1rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .reset-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(230, 57, 70, 0.3);
        }

        /* لعبة حجر ورقة مقص */
        .rps-choices {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin: 30px 0;
            flex-wrap: wrap;
        }

        .rps-choice {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .rps-choice:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-5px);
        }

        .rps-results {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 30px 0;
        }

        .rps-player, .rps-opponent {
            text-align: center;
            flex: 1;
        }

        .rps-choice-display {
            width: 120px;
            height: 120px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            margin: 0 auto 15px;
        }

        /* لعبة الدوز - تصميم جديد */
        .dooz-board {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            max-width: 450px;
            margin: 0 auto 30px;
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .dooz-cell {
            aspect-ratio: 1;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            cursor: pointer;
            transition: var(--transition);
            border: 3px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .dooz-cell::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at center, transparent 30%, rgba(255, 255, 255, 0.1) 100%);
            opacity: 0;
            transition: var(--transition);
        }

        .dooz-cell:hover::before {
            opacity: 1;
        }

        .dooz-cell:hover {
            transform: scale(1.05);
            border-color: var(--accent);
        }

        .dooz-cell.player1 {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            box-shadow: 0 0 20px rgba(0, 180, 216, 0.5);
            border-color: var(--accent-light);
        }

        .dooz-cell.player2 {
            background: linear-gradient(135deg, var(--warning), #cc7a00);
            box-shadow: 0 0 20px rgba(255, 158, 0, 0.5);
            border-color: #ffb74d;
        }

        .dooz-cell.winning {
            animation: winningCell 1s ease infinite;
        }

        @keyframes winningCell {
            0%, 100% { transform: scale(1); box-shadow: 0 0 20px rgba(56, 176, 0, 0.7); }
            50% { transform: scale(1.1); box-shadow: 0 0 30px rgba(56, 176, 0, 1); }
        }

        /* لعبة الحية والدرج */
        .snake-board {
            max-width: 600px;
            margin: 0 auto 30px;
        }

        .board-grid {
            display: grid;
            grid-template-columns: repeat(10, 1fr);
            gap: 5px;
        }

        .board-cell {
            aspect-ratio: 1;
            background: rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            position: relative;
        }

        .board-cell.player1::after {
            content: '👤';
            position: absolute;
            font-size: 1.2rem;
        }

        .board-cell.player2::after {
            content: '🤖';
            position: absolute;
            font-size: 1.2rem;
        }

        .board-cell.ladder {
            background: rgba(56, 176, 0, 0.3);
        }

        .board-cell.snake {
            background: rgba(230, 57, 70, 0.3);
        }

        .dice-container {
            text-align: center;
            margin: 30px 0;
        }

        .dice {
            width: 80px;
            height: 80px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 20px;
        }

        .roll-button {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: var(--radius);
            font-size: 1.1rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .roll-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 180, 216, 0.3);
        }

        /* التجاوب */
        @media (max-width: 768px) {
            .container {
                padding: 20px;
            }
            
            .search-options {
                grid-template-columns: 1fr;
            }
            
            .games-grid {
                grid-template-columns: 1fr;
            }
            
            .players-display {
                flex-direction: column;
                gap: 20px;
            }
            
            .modal-actions {
                flex-direction: column;
            }
            
            h1 {
                font-size: 2.5rem;
            }
            
            .logo {
                font-size: 4rem;
            }
            
            .rps-choices {
                gap: 10px;
            }
            
            .rps-choice {
                width: 80px;
                height: 80px;
                font-size: 2rem;
            }
            
            .tictactoe-cell, .dooz-cell {
                font-size: 2.5rem;
            }
            
            .game-card {
                padding: 20px;
            }
            
            .welcome-card {
                padding: 30px 20px;
            }
            
            .features {
                gap: 15px;
            }
            
            .feature {
                padding: 15px;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 10px;
            }
            
            .container {
                padding: 15px;
            }
            
            .card {
                padding: 20px;
            }
            
            .features {
                flex-direction: column;
                gap: 15px;
            }
            
            .input-with-button {
                flex-direction: column;
            }
            
            .search-button {
                padding: 15px;
            }
            
            .glow-button, .ai-button {
                padding: 15px 25px;
                font-size: 1.1rem;
            }
            
            .player-info {
                padding: 20px;
            }
            
            .player-details {
                gap: 15px;
            }
            
            .player-avatar {
                width: 50px;
                height: 50px;
                font-size: 1.3rem;
            }
            
            .player-name {
                font-size: 1.3rem;
            }
            
            .player-id {
                font-size: 1rem;
            }
            
            .modal-content {
                padding: 25px;
            }
            
            .notification {
                max-width: 90%;
                right: 5%;
                left: 5%;
            }
            
            .board-grid {
                gap: 3px;
            }
            
            .board-cell {
                font-size: 0.8rem;
            }
            
            .dooz-board {
                gap: 10px;
                padding: 15px;
            }
            
            .dooz-cell {
                font-size: 2rem;
            }
        }

        @media (max-width: 360px) {
            h1 {
                font-size: 2rem;
            }
            
            .logo {
                font-size: 3rem;
            }
            
            .subtitle {
                font-size: 1.1rem;
            }
            
            .welcome-card h2 {
                font-size: 2rem;
            }
            
            .game-header h2 {
                font-size: 1.6rem;
            }
            
            .player-turn {
                font-size: 1.1rem;
            }
            
            .tictactoe-cell, .dooz-cell {
                font-size: 2rem;
            }
            
            .rps-choice {
                width: 70px;
                height: 70px;
                font-size: 1.8rem;
            }
            
            .rps-choice-display {
                width: 100px;
                height: 100px;
                font-size: 2.5rem;
            }
        }

        /* تحسينات للأجهزة المحمولة */
        @media (hover: none) {
            .card:hover::before {
                left: -100%;
            }
            
            .game-card:hover {
                transform: none;
                border-color: transparent;
            }
            
            .game-card:hover .play-button {
                opacity: 0;
            }
            
            .glow-button:hover, .ai-button:hover, .search-button:hover, 
            .quick-btn:hover, .icon-button:hover, .back-button:hover,
            .confirm-button:hover, .cancel-button:hover, .reset-button:hover,
            .roll-button:hover, .rps-choice:hover {
                transform: none;
            }
            
            .feature:hover {
                transform: none;
            }
            
            .dooz-cell:hover {
                transform: none;
                border-color: transparent;
            }
        }

        /* إصلاح شريط العناوين على iOS */
        @supports (-webkit-touch-callout: none) {
            body {
                min-height: -webkit-fill-available;
            }
        }

        /* تحسينات للألوان على الموبايل */
        .mobile-color-fix {
            -webkit-backface-visibility: hidden;
            -webkit-transform: translateZ(0) scale(1.0, 1.0);
            transform: translateZ(0);
        }

        /* تحسينات للألعاب على الموبايل */
        .game-container, .card, .player-info, .opponent-display {
            will-change: transform;
        }

        /* تحسينات للألوان المتدرجة على الموبايل */
        .gradient-fix {
            background-attachment: scroll !important;
        }
    </style>
</head>
<body>
    <div class="background-animation gradient-fix"></div>
    
    <header class="mobile-color-fix">
        <div class="logo">🎮</div>
        <h1>GameZone</h1>
        <p class="subtitle">تطبيق الألعاب الجماعية - تحدّي الأصدقاء أو الذكاء الاصطناعي!</p>
    </header>

    <div class="container mobile-color-fix">
        <!-- قسم تسجيل اللاعب -->
        <div id="playerRegistration" class="card welcome-card">
            <h2><i class="fas fa-user-plus"></i> مرحباً في GameZone!</h2>
            <div class="form-group">
                <label for="username">أدخل اسمك للبدء:</label>
                <input type="text" id="username" placeholder="اكتب اسمك هنا..." maxlength="20">
            </div>
            <button id="saveName" class="glow-button">
                <i class="fas fa-play"></i> ابدأ اللعب
            </button>
            
            <div class="features">
                <div class="feature">
                    <i class="fas fa-users"></i>
                    <span>العب مع الأصدقاء</span>
                </div>
                <div class="feature">
                    <i class="fas fa-robot"></i>
                    <span>تحدى الذكاء الاصطناعي</span>
                </div>
                <div class="feature">
                    <i class="fas fa-trophy"></i>
                    <span>4 ألعاب ممتعة</span>
                </div>
            </div>
        </div>

        <!-- معلومات اللاعب -->
        <div id="playerInfo" class="player-info hidden">
            <div class="player-details">
                <div class="player-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <div class="player-text">
                    <span class="player-name" id="displayName">اللاعب</span>
                    <span class="player-id">ID: <span id="displayId">0000</span></span>
                </div>
            </div>
            <button id="changePlayer" class="icon-button">
                <i class="fas fa-sign-out-alt"></i>
            </button>
        </div>

        <!-- قسم البحث عن خصم -->
        <div id="searchSection" class="card hidden">
            <h2><i class="fas fa-search"></i> ابحث عن منافس</h2>
            
            <div class="search-options">
                <div class="option-card active" id="friendOption">
                    <div class="option-icon">
                        <i class="fas fa-user-friends"></i>
                    </div>
                    <div class="option-text">
                        <h3>العب مع صديق</h3>
                        <p>ادخل ID صديقك للعب معه</p>
                    </div>
                </div>
                
                <div class="option-card" id="aiOption">
                    <div class="option-icon">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div class="option-text">
                        <h3>تحدى الذكاء الاصطناعي</h3>
                        <p>العب ضد الكمبيوتر</p>
                    </div>
                </div>
            </div>

            <!-- خيار اللعب مع صديق -->
            <div id="friendSearch" class="search-content active">
                <div class="form-group">
                    <label for="searchId">أدخل ID الخصم:</label>
                    <div class="input-with-button">
                        <input type="text" id="searchId" placeholder="مثال: 1234" maxlength="4">
                        <button id="searchBtn" class="search-button">
                            <i class="fas fa-search"></i> بحث
                        </button>
                    </div>
                </div>
                
                <div class="quick-actions">
                    <p>اختبار سريع:</p>
                    <div class="quick-buttons">
                        <button class="quick-btn" data-id="1111">ID: 1111</button>
                        <button class="quick-btn" data-id="2222">ID: 2222</button>
                        <button class="quick-btn" data-id="3333">ID: 3333</button>
                    </div>
                </div>
            </div>

            <!-- خيار الذكاء الاصطناعي -->
            <div id="aiSearch" class="search-content">
                <div class="form-group">
                    <label for="aiDifficulty">اختر مستوى الصعوبة:</label>
                    <select id="aiDifficulty" class="styled-select">
                        <option value="easy">🟢 سهل - للمبتدئين</option>
                        <option value="medium">🟡 متوسط - تحدي جيد</option>
                        <option value="hard">🔴 صعب - للمحترفين</option>
                        <option value="impossible">💀 فائق - تحدي مستحيل!</option>
                    </select>
                </div>
                <button id="playWithAI" class="ai-button">
                    <i class="fas fa-play"></i> ابدأ مع الذكاء الاصطناعي
                </button>
            </div>
        </div>

        <!-- قسم اختيار اللعبة -->
        <div id="gameSelection" class="card hidden">
            <h2><i class="fas fa-gamepad"></i> اختر لعبتك المفضلة</h2>
            
            <div class="opponent-display" id="opponentDisplay">
                <div class="opponent-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <div class="opponent-info">
                    <span class="opponent-name" id="opponentNameText">الذكاء الاصطناعي</span>
                    <span class="game-mode" id="gameModeText">متوسط الصعوبة</span>
                </div>
            </div>

            <div class="games-grid">
                <div class="game-card" data-game="snake">
                    <div class="game-icon">
                        <i class="fas fa-snake"></i>
                    </div>
                    <div class="game-info">
                        <h3>حية والدرج</h3>
                        <p>لعبة الحظ والاستراتيجية</p>
                        <div class="game-stats">
                            <span>👥 2 لاعبين</span>
                            <span>⏱️ 10-15 دقيقة</span>
                        </div>
                    </div>
                    <div class="play-button">
                        <i class="fas fa-play"></i>
                    </div>
                </div>

                <div class="game-card" data-game="tictactoe">
                    <div class="game-icon">
                        <i class="fas fa-times"></i>
                    </div>
                    <div class="game-info">
                        <h3>إكس أو</h3>
                        <p>لعبة الذكاء الكلاسيكية</p>
                        <div class="game-stats">
                            <span>👥 2 لاعبين</span>
                            <span>⏱️ 5 دقائق</span>
                        </div>
                    </div>
                    <div class="play-button">
                        <i class="fas fa-play"></i>
                    </div>
                </div>

                <div class="game-card" data-game="rps">
                    <div class="game-icon">
                        <i class="fas fa-hand-rock"></i>
                    </div>
                    <div class="game-info">
                        <h3>حجر ورقة مقص</h3>
                        <p>اختبار الحدس والتوقع</p>
                        <div class="game-stats">
                            <span>👥 2 لاعبين</span>
                            <span>⏱️ سريعة</span>
                        </div>
                    </div>
                    <div class="play-button">
                        <i class="fas fa-play"></i>
                    </div>
                </div>

                <div class="game-card" data-game="dooz">
                    <div class="game-icon">
                        <i class="fas fa-th-large"></i>
                    </div>
                    <div class="game-info">
                        <h3>لعبة الدوز</h3>
                        <p>التخطيط للفوز بخط واحد</p>
                        <div class="game-stats">
                            <span>👥 2 لاعبين</span>
                            <span>⏱️ 5-10 دقائق</span>
                        </div>
                    </div>
                    <div class="play-button">
                        <i class="fas fa-play"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- أقسام الألعاب -->
        <div id="snakeGame" class="game-container hidden">
            <div class="game-header">
                <h2><i class="fas fa-snake"></i> لعبة الحية والدرج</h2>
                <button class="back-button" id="backFromSnake">
                    <i class="fas fa-arrow-right"></i> العودة
                </button>
            </div>
            
            <div class="game-info">
                <div class="player-turn">
                    <span id="snakeTurn">دور: اللاعب 1</span>
                </div>
                <div class="dice-container">
                    <div class="dice" id="snakeDice">
                        <i class="fas fa-dice"></i>
                    </div>
                    <button class="roll-button" id="rollDice">
                        <i class="fas fa-dice-d20"></i> رمي النرد
                    </button>
                </div>
            </div>

            <div class="snake-board">
                <div class="board-grid" id="boardGrid"></div>
            </div>
        </div>

        <div id="tictactoeGame" class="game-container hidden">
            <div class="game-header">
                <h2><i class="fas fa-times"></i> لعبة إكس أو</h2>
                <button class="back-button" id="backFromTictactoe">
                    <i class="fas fa-arrow-right"></i> العودة
                </button>
            </div>
            
            <div class="game-info">
                <div class="player-turn">
                    <span id="tictactoeTurn">دور: ❌</span>
                </div>
            </div>

            <div class="tictactoe-board" id="tictactoeBoard"></div>
            
            <div class="game-info">
                <button class="reset-button" id="resetTictactoe">
                    <i class="fas fa-redo"></i> إعادة اللعبة
                </button>
            </div>
        </div>

        <div id="rpsGame" class="game-container hidden">
            <div class="game-header">
                <h2><i class="fas fa-hand-rock"></i> حجر ورقة مقص</h2>
                <button class="back-button" id="backFromRps">
                    <i class="fas fa-arrow-right"></i> العودة
                </button>
            </div>
            
            <div class="game-info">
                <div class="player-turn">
                    <span id="rpsTurn">اختر حركتك!</span>
                </div>
            </div>

            <div class="rps-choices">
                <button class="rps-choice" data-choice="rock">
                    <i class="fas fa-hand-rock"></i>
                </button>
                <button class="rps-choice" data-choice="paper">
                    <i class="fas fa-hand-paper"></i>
                </button>
