    <!-- منطقة الإشعارات -->
    <div id="notificationContainer"></div>

    <!-- حقوق الملكية -->
    <div class="copyright">
        تم التطوير بواسطة المهندس حسين محمد 2025
    </div>

    <script>
        // تطبيق GameZone
        class GameZone {
            constructor() {
                this.currentPlayer = { name: '', id: '' };
                this.selectedOpponent = null;
                this.selectedGame = '';
                this.gameMode = '';
                this.aiLevel = 'medium';
                this.isSearching = false;
                
                // حالات الألعاب
                this.tictactoeState = {
                    board: ['', '', '', '', '', '', '', '', ''],
                    currentPlayer: '❌',
                    gameActive: true
                };
                
                this.rpsState = {
                    playerScore: 0,
                    opponentScore: 0,
                    rounds: 0
                };
                
                this.snakeState = {
                    players: [
                        { position: 0, name: 'أنت' },
                        { position: 0, name: 'الخصم' }
                    ],
                    currentPlayer: 0,
                    gameActive: true,
                    snakesAndLadders: {
                        4: 14, 9: 31, 20: 38, 28: 84, 40: 59, 51: 67, 63: 81, 71: 91,
                        17: 7, 54: 34, 62: 19, 64: 60, 87: 24, 93: 73, 95: 75, 99: 78
                    }
                };
                
                // حالة لعبة الدوز الجديدة
                this.doozState = {
                    board: Array(9).fill(''),
                    currentPlayer: 1, // 1 للاعب، 2 للخصم
                    gameActive: true,
                    winningCombinations: [
                        [0, 1, 2], [3, 4, 5], [6, 7, 8], // صفوف
                        [0, 3, 6], [1, 4, 7], [2, 5, 8], // أعمدة
                        [0, 4, 8], [2, 4, 6]             // أقطار
                    ]
                };
                
                this.init();
            }

            init() {
                this.bindEvents();
                this.loadPlayerData();
                this.initGames();
            }

            bindEvents() {
                // تسجيل اللاعب
                document.getElementById('saveName').addEventListener('click', () => this.registerPlayer());
                document.getElementById('username').addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') this.registerPlayer();
                });

                // تغيير اللاعب
                document.getElementById('changePlayer').addEventListener('click', () => this.changePlayer());

                // خيارات البحث
                document.getElementById('friendOption').addEventListener('click', () => this.selectSearchOption('friend'));
                document.getElementById('aiOption').addEventListener('click', () => this.selectSearchOption('ai'));

                // البحث عن خصم
                document.getElementById('searchBtn').addEventListener('click', () => this.searchForOpponent());
                document.getElementById('searchId').addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') this.searchForOpponent();
                });

                // الأزرار السريعة
                document.querySelectorAll('.quick-btn').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        const id = e.target.dataset.id;
                        document.getElementById('searchId').value = id;
                        this.searchForOpponent();
                    });
                });

                // الذكاء الاصطناعي
                document.getElementById('playWithAI').addEventListener('click', () => this.playWithAI());

                // اختيار الألعاب
                document.querySelectorAll('.game-card').forEach(card => {
                    card.addEventListener('click', (e) => {
                        const game = e.currentTarget.dataset.game;
                        this.selectGame(game);
                    });
                });

                // المودال
                document.getElementById('confirmGame').addEventListener('click', () => this.startSelectedGame());
                document.getElementById('cancelGame').addEventListener('click', () => this.hideModal());

                // إغلاق المودال بالنقر خارجها
                document.getElementById('gameConfirmationModal').addEventListener('click', (e) => {
                    if (e.target === e.currentTarget) this.hideModal();
                });

                // أزرار العودة من الألعاب
                document.getElementById('backFromSnake').addEventListener('click', () => this.backToMain());
                document.getElementById('backFromTictactoe').addEventListener('click', () => this.backToMain());
                document.getElementById('backFromRps').addEventListener('click', () => this.backToMain());
                document.getElementById('backFromDooz').addEventListener('click', () => this.backToMain());
            }

            registerPlayer() {
                const usernameInput = document.getElementById('username');
                const username = usernameInput.value.trim();
                
                if (!username) {
                    this.showNotification('خطأ في التسجيل', 'يرجى إدخال اسم اللاعب', 'error');
                    usernameInput.focus();
                    return;
                }
                
                if (username.length < 2) {
                    this.showNotification('خطأ في التسجيل', 'اسم اللاعب يجب أن يكون على الأقل حرفين', 'error');
                    usernameInput.focus();
                    return;
                }
                
                // توليد ID فريد
                const userId = Math.floor(1000 + Math.random() * 9000);
                
                localStorage.setItem('playerName', username);
                localStorage.setItem('playerId', userId);
                
                this.currentPlayer.name = username;
                this.currentPlayer.id = userId;
                this.updatePlayerDisplay();
                this.showGameSelection();
                
                this.showNotification(
                    'تم التسجيل بنجاح! 🎉',
                    `ID الخاص بك هو: ${userId} - شاركه مع أصدقائك!`,
                    'success'
                );
            }

            updatePlayerDisplay() {
                document.getElementById('displayName').textContent = this.currentPlayer.name;
                document.getElementById('displayId').textContent = this.currentPlayer.id;
                document.getElementById('playerNameModal').textContent = this.currentPlayer.name;
            }

            loadPlayerData() {
                const savedName = localStorage.getItem('playerName');
                const savedId = localStorage.getItem('playerId');
                
                if (savedName && savedId) {
                    this.currentPlayer.name = savedName;
                    this.currentPlayer.id = savedId;
                    this.updatePlayerDisplay();
                    this.showGameSelection();
                    
                    this.showNotification(
                        'مرحباً بعودتك! 👋',
                        `تم تحميل بياناتك: ${savedName}`,
                        'success'
                    );
                }
            }

            showNotification(title, message, type = 'info') {
                const notification = document.createElement('div');
                notification.className = 'notification';
                notification.innerHTML = `
                    <div class="notification-icon">
                        <i class="fas fa-${type === 'error' ? 'times-circle' : type === 'success' ? 'check-circle' : 'info-circle'}"></i>
                    </div>
                    <div class="notification-content">
                        <div class="notification-title">${title}</div>
                        <div class="notification-message">${message}</div>
                    </div>
                    <button class="notification-close" onclick="this.parentElement.remove()">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                
                document.getElementById('notificationContainer').appendChild(notification);
                
                // إزالة تلقائية بعد 5 ثواني
                setTimeout(() => {
                    if (notification.parentElement) {
                        notification.remove();
                    }
                }, 5000);
            }

            selectSearchOption(option) {
                const friendOption = document.getElementById('friendOption');
                const aiOption = document.getElementById('aiOption');
                const friendSearch = document.getElementById('friendSearch');
                const aiSearch = document.getElementById('aiSearch');

                if (option === 'friend') {
                    friendOption.classList.add('active');
                    aiOption.classList.remove('active');
                    friendSearch.classList.add('active');
                    aiSearch.classList.remove('active');
                } else {
                    aiOption.classList.add('active');
                    friendOption.classList.remove('active');
                    aiSearch.classList.add('active');
                    friendSearch.classList.remove('active');
                }
            }

            searchForOpponent() {
                if (this.isSearching) return;
                
                const searchIdInput = document.getElementById('searchId');
                const opponentId = searchIdInput.value.trim();
                
                if (!opponentId) {
                    this.showNotification('خطأ في البحث', 'يرجى إدخال ID الخصم', 'error');
                    searchIdInput.focus();
                    return;
                }
                
                if (opponentId.length !== 4) {
                    this.showNotification('خطأ في البحث', 'ID يجب أن يتكون من 4 أرقام', 'error');
                    searchIdInput.focus();
                    return;
                }
                
                if (opponentId === this.currentPlayer.id) {
                    this.showNotification('خطأ في البحث', 'لا يمكنك البحث عن نفسك!', 'error');
                    searchIdInput.focus();
                    return;
                }
                
                this.isSearching = true;
                const searchBtn = document.getElementById('searchBtn');
                searchBtn.disabled = true;
                searchBtn.innerHTML = '<span class="loading"></span> جاري البحث...';
                
                this.showNotification(
                    'جاري البحث عن الخصم',
                    'يتم الآن البحث عن اللاعب المراد...',
                    'info'
                );
                
                // محاكاة البحث
                setTimeout(() => {
                    this.selectedOpponent = {
                        name: `اللاعب ${opponentId}`,
                        id: opponentId
                    };
                    
                    this.isSearching = false;
                    searchBtn.disabled = false;
                    searchBtn.innerHTML = '<i class="fas fa-search"></i> بحث';
                    
                    this.gameMode = 'friend';
                    this.enableGameButtons();
                    this.updateOpponentDisplay();
                    
                    this.showNotification(
                        'تم العثور على الخصم! 🎯',
                        `يمكنك الآن اختيار اللعبة مع ${this.selectedOpponent.name}`,
                        'success'
                    );
                }, 2000);
            }

            playWithAI() {
                this.aiLevel = document.getElementById('aiDifficulty').value;
                this.gameMode = 'ai';
                this.selectedOpponent = {
                    name: `الذكاء الاصطناعي (${this.getAIDifficultyText()})`,
                    id: 'AI'
                };
                
                this.enableGameButtons();
                this.updateOpponentDisplay();
                
                this.showNotification(
                    'تم تفعيل الذكاء الاصطناعي! 🤖',
                    `مستوى الصعوبة: ${this.getAIDifficultyText()}`,
                    'success'
                );
            }

            getAIDifficultyText() {
                const levels = {
                    easy: 'سهل',
                    medium: 'متوسط', 
                    hard: 'صعب',
                    impossible: 'فائق'
                };
                return levels[this.aiLevel];
            }

            updateOpponentDisplay() {
                document.getElementById('opponentNameText').textContent = this.selectedOpponent.name;
                document.getElementById('opponentNameModal').textContent = this.selectedOpponent.name;
                document.getElementById('gameModeText').textContent = this.gameMode === 'ai' ? 
                    `${this.getAIDifficultyText()} الصعوبة` : 'العب مع صديق';
            }

            enableGameButtons() {
                document.querySelectorAll('.game-card').forEach(card => {
                    card.style.opacity = '1';
                    card.style.pointerEvents = 'auto';
                });
            }

            selectGame(game) {
                if (!this.gameMode) {
                    this.showNotification(
                        'لم تختر نمط اللعب',
                        'يرجى البحث عن خصم أو تفعيل الذكاء الاصطناعي أولاً',
                        'warning'
                    );
                    return;
                }
                
                this.selectedGame = game;
                this.showGameModal();
            }

            showGameModal() {
                const gameInfo = {
                    snake: { name: 'حية والدرج', desc: 'لعبة الحظ والاستراتيجية', icon: 'fas fa-snake' },
                    tictactoe: { name: 'إكس أو', desc: 'لعبة الذكاء الكلاسيكية', icon: 'fas fa-times' },
                    rps: { name: 'حجر ورقة مقص', desc: 'اختبار الحدس والتوقع', icon: 'fas fa-hand-rock' },
                    dooz: { name: 'لعبة الدوز', desc: 'التخطيط للفوز بخط واحد', icon: 'fas fa-th-large' }
                };
                
                const info = gameInfo[this.selectedGame];
                document.getElementById('selectedGameNameModal').textContent = info.name;
                document.getElementById('gameDescriptionModal').textContent = info.desc;
                
                const iconElement = document.querySelector('.game-icon-modal i');
                iconElement.className = info.icon;
                
                document.getElementById('gameConfirmationModal').classList.remove('hidden');
            }

            hideModal() {
                document.getElementById('gameConfirmationModal').classList.add('hidden');
            }

            startSelectedGame() {
                this.hideModal();
                this.hideAllSections();
                
                // عرض اللعبة المحددة
                document.getElementById(`${this.selectedGame}Game`).classList.remove('hidden');
                
                // تهيئة اللعبة المحددة
                this.initSelectedGame();
                
                this.showNotification(
                    'بدأت اللعبة! 🎮',
                    `حظاً طيباً في ${this.getGameName(this.selectedGame)}`,
                    'success'
                );
            }

            initSelectedGame() {
                switch(this.selectedGame) {
                    case 'tictactoe':
                        this.initTictactoeGame();
                        break;
                    case 'rps':
                        this.initRPSGame();
                        break;
                    case 'snake':
                        this.initSnakeGame();
                        break;
                    case 'dooz':
                        this.initDoozGame();
                        break;
                }
            }

            backToMain() {
                this.hideAllSections();
                this.showGameSelection();
            }

            hideAllSections() {
                const sections = [
                    'playerRegistration', 'playerInfo', 'searchSection', 
                    'gameSelection', 'snakeGame', 'tictactoeGame', 
                    'rpsGame', 'doozGame'
                ];
                
                sections.forEach(section => {
                    document.getElementById(section).classList.add('hidden');
                });
                this.hideModal();
            }

            showGameSelection() {
                this.hideAllSections();
                document.getElementById('playerInfo').classList.remove('hidden');
                document.getElementById('searchSection').classList.remove('hidden');
                document.getElementById('gameSelection').classList.remove('hidden');
            }

            changePlayer() {
                if (confirm('هل تريد حقاً تغيير اللاعب؟ سيتم فقدان بياناتك الحالية.')) {
                    localStorage.removeItem('playerName');
                    localStorage.removeItem('playerId');
                    this.showMainScreen();
                    document.getElementById('username').value = '';
                    document.getElementById('username').focus();
                }
            }

            showMainScreen() {
                this.hideAllSections();
                document.getElementById('playerRegistration').classList.remove('hidden');
            }

            getGameName(game) {
                const names = {
                    snake: 'حية والدرج',
                    tictactoe: 'إكس أو',
                    rps: 'حجر ورقة مقص', 
                    dooz: 'لعبة الدوز'
                };
                return names[game];
            }

            initGames() {
                // سيتم تهيئة الألعاب عند بدئها
            }

            // لعبة إكس أو (Tic Tac Toe)
            initTictactoeGame() {
                const boardElement = document.getElementById('tictactoeBoard');
                boardElement.innerHTML = '';
                
                this.tictactoeState.board.fill('');
                this.tictactoeState.currentPlayer = '❌';
                this.tictactoeState.gameActive = true;
                
                document.getElementById('tictactoeTurn').textContent = 'دور: ❌';
                document.getElementById('tictactoeTurn').style.color = '#00b4d8';

                for (let i = 0; i < 9; i++) {
                    const cell = document.createElement('div');
                    cell.className = 'tictactoe-cell';
                    cell.dataset.index = i;
                    cell.addEventListener('click', () => this.handleTictactoeClick(i));
                    boardElement.appendChild(cell);
                }

                document.getElementById('resetTictactoe').addEventListener('click', () => this.resetTictactoe());
            }

            handleTictactoeClick(index) {
                if (!this.tictactoeState.gameActive || this.tictactoeState.board[index] !== '') return;

                this.tictactoeState.board[index] = this.tictactoeState.currentPlayer;
                document.querySelector(`#tictactoeBoard [data-index="${index}"]`).textContent = this.tictactoeState.currentPlayer;
                document.querySelector(`#tictactoeBoard [data-index="${index}"]`).classList.add(this.tictactoeState.currentPlayer === '❌' ? 'x' : 'o');

                if (this.checkTictactoeWin()) {
                    this.endTictactoeGame(`فاز ${this.tictactoeState.currentPlayer}! 🎉`, 'win');
                    return;
                }

                if (this.tictactoeState.board.every(cell => cell !== '')) {
                    this.endTictactoeGame('تعادل! 🤝', 'draw');
                    return;
                }

                this.tictactoeState.currentPlayer = this.tictactoeState.currentPlayer === '❌' ? '⭕️' : '❌';
                document.getElementById('tictactoeTurn').textContent = `دور: ${this.tictactoeState.currentPlayer}`;

                // إذا كان ضد الذكاء الاصطناعي
                if (this.gameMode === 'ai' && this.tictactoeState.currentPlayer === '⭕️') {
                    setTimeout(() => this.aiTictactoeMove(), 500);
                }
            }

            aiTictactoeMove() {
                // الذكاء الاصطناعي بمستوى الفائق الصعوبة
                if (this.aiLevel === 'impossible') {
                    // خوارزمية minimax لمستوى الفائق
                    const bestMove = this.findBestMove();
                    if (bestMove !== -1) {
                        this.handleTictactoeClick(bestMove);
                        return;
                    }
                }
                
                // الذكاء الاصطناعي بمستوى صعب
                if (this.aiLevel === 'hard') {
                    // محاولة الفوز أو منع الفوز
                    const winMove = this.findWinningMove('⭕️');
                    if (winMove !== -1) {
                        this.handleTictactoeClick(winMove);
                        return;
                    }
                    
                    const blockMove = this.findWinningMove('❌');
                    if (blockMove !== -1) {
                        this.handleTictactoeClick(blockMove);
                        return;
                    }
                }
                
                // الذكاء الاصطناعي بمستوى متوسط
                if (this.aiLevel === 'medium') {
                    // 70% احتمال لاختيار حركة جيدة
                    if (Math.random() < 0.7) {
                        const winMove = this.findWinningMove('⭕️');
                        if (winMove !== -1) {
                            this.handleTictactoeClick(winMove);
                            return;
                        }
                        
                        const blockMove = this.findWinningMove('❌');
                        if (blockMove !== -1) {
                            this.handleTictactoeClick(blockMove);
                            return;
                        }
                    }
                }
                
                // اختيار عشوائي للحركة المتبقية
                const availableMoves = this.tictactoeState.board
                    .map((cell, index) => cell === '' ? index : null)
                    .filter(index => index !== null);

                if (availableMoves.length > 0) {
                    const randomIndex = availableMoves[Math.floor(Math.random() * availableMoves.length)];
                    this.handleTictactoeClick(randomIndex);
                }
            }

            findWinningMove(player) {
                const winPatterns = [
                    [0, 1, 2], [3, 4, 5], [6, 7, 8], // صفوف
                    [0, 3, 6], [1, 4, 7], [2, 5, 8], // أعمدة
                    [0, 4, 8], [2, 4, 6]             // أقطار
                ];

                for (const pattern of winPatterns) {
                    const [a, b, c] = pattern;
                    const cells = [this.tictactoeState.board[a], this.tictactoeState.board[b], this.tictactoeState.board[c]];
                    
                    // إذا كان هناك خليتان للاعب وخلية فارغة
                    if (cells.filter(cell => cell === player).length === 2) {
                        const emptyIndex = pattern.find(index => this.tictactoeState.board[index] === '');
                        if (emptyIndex !== undefined) {
                            return emptyIndex;
                        }
                    }
                }
                return -1;
            }

            findBestMove() {
                // خوارزمية مبسطة لمستوى الفائق
                // أولوية المركز
                if (this.tictactoeState.board[4] === '') return 4;
                
                // ثم الزوايا
                const corners = [0, 2, 6, 8];
                const availableCorners = corners.filter(index => this.tictactoeState.board[index] === '');
                if (availableCorners.length > 0) {
                    return availableCorners[Math.floor(Math.random() * availableCorners.length)];
                }
                
                // ثم الحواف
                const edges = [1, 3, 5, 7];
                const availableEdges = edges.filter(index => this.tictactoeState.board[index] === '');
                if (availableEdges.length > 0) {
                    return availableEdges[Math.floor(Math.random() * availableEdges.length)];
                }
                
                return -1;
            }

            checkTictactoeWin() {
                const winPatterns = [
                    [0, 1, 2], [3, 4, 5], [6, 7, 8], // صفوف
                    [0, 3, 6], [1, 4, 7], [2, 5, 8], // أعمدة
                    [0, 4, 8], [2, 4, 6]             // أقطار
                ];

                return winPatterns.some(pattern => {
                    const [a, b, c] = pattern;
                    return this.tictactoeState.board[a] && 
                           this.tictactoeState.board[a] === this.tictactoeState.board[b] && 
                           this.tictactoeState.board[a] === this.tictactoeState.board[c];
                });
            }

            endTictactoeGame(message, type) {
                this.tictactoeState.gameActive = false;
                document.getElementById('tictactoeTurn').textContent = message;
                document.getElementById('tictactoeTurn').style.color = type === 'win' ? '#38b000' : '#ff9e00';
            }

            resetTictactoe() {
                this.tictactoeState.board.fill('');
                this.tictactoeState.currentPlayer = '❌';
                this.tictactoeState.gameActive = true;

                document.querySelectorAll('#tictactoeBoard .tictactoe-cell').forEach(cell => {
                    cell.textContent = '';
                    cell.classList.remove('x', 'o');
                });

                document.getElementById('tictactoeTurn').textContent = 'دور: ❌';
                document.getElementById('tictactoeTurn').style.color = '#00b4d8';
            }

            // لعبة حجر ورقة مقص (Rock Paper Scissors)
            initRPSGame() {
                this.rpsState.playerScore = 0;
                this.rpsState.opponentScore = 0;
                this.rpsState.rounds = 0;
                
                document.getElementById('playerChoice').innerHTML = '<i class="fas fa-question"></i>';
                document.getElementById('opponentChoice').innerHTML = '<i class="fas fa-question"></i>';
                document.getElementById('rpsResult').textContent = 'النتيجة تظهر هنا';
                document.getElementById('rpsResult').style.color = '#f8f9fa';
                document.getElementById('rpsTurn').textContent = 'اختر حركتك!';

                document.querySelectorAll('.rps-choice').forEach(button => {
                    button.addEventListener('click', (e) => {
                        const playerChoice = e.currentTarget.dataset.choice;
                        this.playRPS(playerChoice);
                    });
                });

                document.getElementById('resetRps').addEventListener('click', () => this.resetRPS());
            }

            playRPS(playerChoice) {
                let opponentChoice;
                
                // الذكاء الاصطناعي بمستوى الفائق
                if (this.aiLevel === 'impossible') {
                    // 90% احتمال لاختيار الحركة المناسبة للفوز
                    if (Math.random() < 0.9) {
                        if (playerChoice === 'rock') opponentChoice = 'paper';
                        else if (playerChoice === 'paper') opponentChoice = 'scissors';
                        else opponentChoice = 'rock';
                    } else {
                        // 10% احتمال لاختيار عشوائي
                        const choices = ['rock', 'paper', 'scissors'];
                        opponentChoice = choices[Math.floor(Math.random() * 3)];
                    }
                } 
                // الذكاء الاصطناعي بمستوى صعب
                else if (this.aiLevel === 'hard') {
                    // 70% احتمال لاختيار الحركة المناسبة للفوز
                    if (Math.random() < 0.7) {
                        if (playerChoice === 'rock') opponentChoice = 'paper';
                        else if (playerChoice === 'paper') opponentChoice = 'scissors';
                        else opponentChoice = 'rock';
                    } else {
                        const choices = ['rock', 'paper', 'scissors'];
                        opponentChoice = choices[Math.floor(Math.random() * 3)];
                    }
                }
                // الذكاء الاصطناعي بمستوى متوسط
                else if (this.aiLevel === 'medium') {
                    // 50% احتمال لاختيار الحركة المناسبة للفوز
                    if (Math.random() < 0.5) {
                        if (playerChoice === 'rock') opponentChoice = 'paper';
                        else if (playerChoice === 'paper') opponentChoice = 'scissors';
                        else opponentChoice = 'rock';
                    } else {
                        const choices = ['rock', 'paper', 'scissors'];
                        opponentChoice = choices[Math.floor(Math.random() * 3)];
                    }
                }
                // الذكاء الاصطناعي بمستوى سهل
                else {
                    const choices = ['rock', 'paper', 'scissors'];
                    opponentChoice = choices[Math.floor(Math.random() * 3)];
                }

                // تحديث العرض
                document.getElementById('playerChoice').innerHTML = this.getRPSIcon(playerChoice);
                document.getElementById('opponentChoice').innerHTML = this.getRPSIcon(opponentChoice);

                // تحديد الفائز
                const result = this.getRPSResult(playerChoice, opponentChoice);
                document.getElementById('rpsResult').textContent = result.message;
                document.getElementById('rpsResult').style.color = result.color;
                
                this.rpsState.rounds++;
                
                if (result.type === 'win') {
                    this.rpsState.playerScore++;
                } else if (result.type === 'lose') {
                    this.rpsState.opponentScore++;
                }
                
                // تحديث النتيجة
                setTimeout(() => {
                    document.getElementById('rpsResult').textContent = 
                        `النتيجة: ${this.rpsState.playerScore} - ${this.rpsState.opponentScore} (${this.rpsState.rounds} جولة)`;
                }, 2000);
            }

            getRPSIcon(choice) {
                const icons = {
                    rock: '<i class="fas fa-hand-rock"></i>',
                    paper: '<i class="fas fa-hand-paper"></i>',
                    scissors: '<i class="fas fa-hand-scissors"></i>'
                };
                return icons[choice];
            }

            getRPSResult(player, opponent) {
                if (player === opponent) {
                    return { message: 'تعادل! 🤝', color: '#ff9e00', type: 'draw' };
                }

                if (
                    (player === 'rock' && opponent === 'scissors') ||
                    (player === 'paper' && opponent === 'rock') ||
                    (player === 'scissors' && opponent === 'paper')
                ) {
                    return { message: 'فزت! 🎉', color: '#38b000', type: 'win' };
                }

                return { message: 'خسرت! 😞', color: '#e63946', type: 'lose' };
            }

            resetRPS() {
                this.rpsState.playerScore = 0;
                this.rpsState.opponentScore = 0;
                this.rpsState.rounds = 0;
                
                document.getElementById('playerChoice').innerHTML = '<i class="fas fa-question"></i>';
                document.getElementById('opponentChoice').innerHTML = '<i class="fas fa-question"></i>';
                document.getElementById('rpsResult').textContent = 'النتيجة تظهر هنا';
                document.getElementById('rpsResult').style.color = '#f8f9fa';
                document.getElementById('rpsTurn').textContent = 'اختر حركتك!';
            }

            // لعبة الحية والدرج (Snake and Ladder)
            initSnakeGame() {
                this.createSnakeBoard();
                document.getElementById('rollDice').addEventListener('click', () => this.rollSnakeDice());
                document.getElementById('snakeTurn').textContent = 'دور: اللاعب 1';
                
                this.snakeState.players[0].position = 0;
                this.snakeState.players[1].position = 0;
                this.snakeState.currentPlayer = 0;
                this.snakeState.gameActive = true;
            }

            createSnakeBoard() {
                const boardGrid = document.getElementById('boardGrid');
                boardGrid.innerHTML = '';

                for (let i = 100; i >= 1; i--) {
                    const cell = document.createElement('div');
                    cell.className = 'board-cell';
                    cell.textContent = i;

                    if (this.snakeState.snakesAndLadders[i]) {
                        const isLadder = this.snakeState.snakesAndLadders[i] > i;
                        cell.classList.add(isLadder ? 'ladder' : 'snake');
                    }

                    boardGrid.appendChild(cell);
                }

                this.updateSnakeBoard();
            }

            updateSnakeBoard() {
                // إزالة اللاعبين السابقين
                document.querySelectorAll('.board-cell').forEach(cell => {
                    cell.classList.remove('player1', 'player2');
                });

                // إضافة اللاعبين الجدد
                const player1Cell = document.querySelectorAll('.board-cell')[100 - this.snakeState.players[0].position];
                const player2Cell = document.querySelectorAll('.board-cell')[100 - this.snakeState.players[1].position];

                if (player1Cell && this.snakeState.players[0].position > 0) player1Cell.classList.add('player1');
                if (player2Cell && this.snakeState.players[1].position > 0) player2Cell.classList.add('player2');
            }

            rollSnakeDice() {
                if (!this.snakeState.gameActive) return;
                if (this.gameMode === 'ai' && this.snakeState.currentPlayer === 1) return;

                const diceValue = Math.floor(Math.random() * 6) + 1;
                const diceElement = document.getElementById('snakeDice');
                
                // تأثير رمي النرد
                diceElement.style.animation = 'none';
                setTimeout(() => {
                    diceElement.style.animation = 'bounce 0.5s ease';
                    diceElement.innerHTML = this.getDiceFace(diceValue);
                }, 10);

                setTimeout(() => {
                    this.moveSnakePlayer(diceValue);
                }, 500);
            }

            getDiceFace(value) {
                const faces = [
                    '<i class="fas fa-dice-one"></i>',
                    '<i class="fas fa-dice-two"></i>',
                    '<i class="fas fa-dice-three"></i>',
                    '<i class="fas fa-dice-four"></i>',
                    '<i class="fas fa-dice-five"></i>',
                    '<i class="fas fa-dice-six"></i>'
                ];
                return faces[value - 1];
            }

            moveSnakePlayer(diceValue) {
                const player = this.snakeState.players[this.snakeState.currentPlayer];
                player.position += diceValue;

                // التحقق من السلالم والثعابين
                if (this.snakeState.snakesAndLadders[player.position]) {
                    const newPosition = this.snakeState.snakesAndLadders[player.position];
                    const isLadder = newPosition > player.position;
                    
                    this.showNotification(
                        isLadder ? 'سلم! 🪜' : 'ثعبان! 🐍',
                        `${player.name} ${isLadder ? 'صعد' : 'هبط'} من ${player.position} إلى ${newPosition}`,
                        isLadder ? 'success' : 'error'
                    );
                    
                    player.position = newPosition;
                }

                // التحقق من الفوز
                if (player.position >= 100) {
                    player.position = 100;
                    this.endSnakeGame(`${player.name} فاز! 🎉`);
                    return;
                }

                this.updateSnakeBoard();
                document.getElementById('snakeTurn').textContent = `دور: ${this.snakeState.players[this.snakeState.currentPlayer].name}`;

                // تبديل اللاعب
                this.snakeState.currentPlayer = (this.snakeState.currentPlayer + 1) % 2;

                // إذا كان ضد الذكاء الاصطناعي
                if (this.gameMode === 'ai' && this.snakeState.currentPlayer === 1) {
                    setTimeout(() => this.aiSnakeRollDice(), 1000);
                }
            }

            aiSnakeRollDice() {
                if (!this.snakeState.gameActive) return;

                const diceValue = Math.floor(Math.random() * 6) + 1;
                const diceElement = document.getElementById('snakeDice');
                
                diceElement.style.animation = 'none';
                setTimeout(() => {
                    diceElement.style.animation = 'bounce 0.5s ease';
                    diceElement.innerHTML = this.getDiceFace(diceValue);
                }, 10);

                setTimeout(() => {
                    this.moveSnakePlayer(diceValue);
                }, 500);
            }

            endSnakeGame(message) {
                this.snakeState.gameActive = false;
                document.getElementById('snakeTurn').textContent = message;
                document.getElementById('snakeTurn').style.color = '#38b000';
                document.getElementById('rollDice').disabled = true;

                this.showNotification(
                    'انتهت اللعبة! 🏆',
                    message,
                    'success'
                );
            }

            // لعبة الدوز - تصميم جديد
            initDoozGame() {
                const boardElement = document.getElementById('doozBoard');
                boardElement.innerHTML = '';
                
                this.doozState.board.fill('');
                this.doozState.currentPlayer = 1;
                this.doozState.gameActive = true;
                
                document.getElementById('doozTurn').textContent = 'دور: اللاعب 1';
                document.getElementById('doozTurn').style.color = '#00b4d8';

                for (let i = 0; i < 9; i++) {
                    const cell = document.createElement('div');
                    cell.className = 'dooz-cell';
                    cell.dataset.index = i;
                    cell.addEventListener('click', () => this.handleDoozClick(i));
                    boardElement.appendChild(cell);
                }

                document.getElementById('resetDooz').addEventListener('click', () => this.resetDooz());
            }

            handleDoozClick(index) {
                if (!this.doozState.gameActive || this.doozState.board[index] !== '') return;

                this.doozState.board[index] = this.doozState.currentPlayer;
                const cell = document.querySelector(`#doozBoard [data-index="${index}"]`);
                
                // تحديث مظهر الخلية
                cell.classList.add(this.doozState.currentPlayer === 1 ? 'player1' : 'player2');
                
                // التحقق من الفوز
                const winner = this.checkDoozWin();
                if (winner) {
                    this.endDoozGame(`فاز ${winner === 1 ? 'اللاعب 1' : 'اللاعب 2'}! 🎉`, 'win');
                    this.highlightWinningCells();
                    return;
                }

                // التحقق من التعادل
                if (this.doozState.board.every(cell => cell !== '')) {
                    this.endDoozGame('تعادل! 🤝', 'draw');
                    return;
                }

                // تبديل اللاعب
                this.doozState.currentPlayer = this.doozState.currentPlayer === 1 ? 2 : 1;
                document.getElementById('doozTurn').textContent = `دور: ${this.doozState.currentPlayer === 1 ? 'اللاعب 1' : 'اللاعب 2'}`;

                // إذا كان ضد الذكاء الاصطناعي
                if (this.gameMode === 'ai' && this.doozState.currentPlayer === 2) {
                    setTimeout(() => this.aiDoozMove(), 500);
                }
            }

            aiDoozMove() {
                // الذكاء الاصطناعي بمستوى الفائق
                if (this.aiLevel === 'impossible') {
                    // محاولة الفوز
                    const winMove = this.findDoozWinningMove(2);
                    if (winMove !== -1) {
                        this.handleDoozClick(winMove);
                        return;
                    }
                    
                    // منع الفوز
                    const blockMove = this.findDoozWinningMove(1);
                    if (blockMove !== -1) {
                        this.handleDoozClick(blockMove);
                        return;
                    }
                    
                    // اختيار استراتيجي
                    const strategicMove = this.findStrategicMove();
                    if (strategicMove !== -1) {
                        this.handleDoozClick(strategicMove);
                        return;
                    }
                }
                
                // الذكاء الاصطناعي بمستوى صعب
                if (this.aiLevel === 'hard') {
                    // 80% احتمال لاختيار حركة جيدة
                    if (Math.random() < 0.8) {
                        const winMove = this.findDoozWinningMove(2);
                        if (winMove !== -1) {
                            this.handleDoozClick(winMove);
                            return;
                        }
                        
                        const blockMove = this.findDoozWinningMove(1);
                        if (blockMove !== -1) {
                            this.handleDoozClick(blockMove);
                            return;
                        }
                    }
                }
                
                // الذكاء الاصطناعي بمستوى متوسط
                if (this.aiLevel === 'medium') {
                    // 60% احتمال لاختيار حركة جيدة
                    if (Math.random() < 0.6) {
                        const winMove = this.findDoozWinningMove(2);
                        if (winMove !== -1) {
                            this.handleDoozClick(winMove);
                            return;
                        }
                        
                        const blockMove = this.findDoozWinningMove(1);
                        if (blockMove !== -1) {
                            this.handleDoozClick(blockMove);
                            return;
                        }
                    }
                }
                
                // اختيار عشوائي للحركة المتبقية
                const availableMoves = this.doozState.board
                    .map((cell, index) => cell === '' ? index : null)
                    .filter(index => index !== null);

                if (availableMoves.length > 0) {
                    const randomIndex = availableMoves[Math.floor(Math.random() * availableMoves.length)];
                    this.handleDoozClick(randomIndex);
                }
            }

            findDoozWinningMove(player) {
                for (const combination of this.doozState.winningCombinations) {
                    const [a, b, c] = combination;
                    const cells = [this.doozState.board[a], this.doozState.board[b], this.doozState.board[c]];
                    
                    // إذا كان هناك خليتان للاعب وخلية فارغة
                    if (cells.filter(cell => cell === player).length === 2) {
                        const emptyIndex = combination.find(index => this.doozState.board[index] === '');
                        if (emptyIndex !== undefined) {
                            return emptyIndex;
                        }
                    }
                }
                return -1;
            }

            findStrategicMove() {
                // أولوية المركز
                if (this.doozState.board[4] === '') return 4;
                
                // ثم الزوايا
                const corners = [0, 2, 6, 8];
                const availableCorners = corners.filter(index => this.doozState.board[index] === '');
                if (availableCorners.length > 0) {
                    return availableCorners[Math.floor(Math.random() * availableCorners.length)];
                }
                
                // ثم الحواف
                const edges = [1, 3, 5, 7];
                const availableEdges = edges.filter(index => this.doozState.board[index] === '');
                if (availableEdges.length > 0) {
                    return availableEdges[Math.floor(Math.random() * availableEdges.length)];
                }
                
                return -1;
            }

            checkDoozWin() {
                for (const combination of this.doozState.winningCombinations) {
                    const [a, b, c] = combination;
                    if (this.doozState.board[a] && 
                        this.doozState.board[a] === this.doozState.board[b] && 
                        this.doozState.board[a] === this.doozState.board[c]) {
                        return this.doozState.board[a];
                    }
                }
                return null;
            }

            highlightWinningCells() {
                for (const combination of this.doozState.winningCombinations) {
                    const [a, b, c] = combination;
                    if (this.doozState.board[a] && 
                        this.doozState.board[a] === this.doozState.board[b] && 
                        this.doozState.board[a] === this.doozState.board[c]) {
                        
                        combination.forEach(index => {
                            document.querySelector(`#doozBoard [data-index="${index}"]`).classList.add('winning');
                        });
                        break;
                    }
                }
            }

            endDoozGame(message, type) {
                this.doozState.gameActive = false;
                document.getElementById('doozTurn').textContent = message;
                document.getElementById('doozTurn').style.color = type === 'win' ? '#38b000' : '#ff9e00';
            }

            resetDooz() {
                this.doozState.board.fill('');
                this.doozState.currentPlayer = 1;
                this.doozState.gameActive = true;

                document.querySelectorAll('#doozBoard .dooz-cell').forEach(cell => {
                    cell.classList.remove('player1', 'player2', 'winning');
                });

                document.getElementById('doozTurn').textContent = 'دور: اللاعب 1';
                document.getElementById('doozTurn').style.color = '#00b4d8';
            }
        }

        // بدء التطبيق عند تحميل الصفحة
        document.addEventListener('DOMContentLoaded', function() {
            window.gameZone = new GameZone();
        });
    </script>
</body>
