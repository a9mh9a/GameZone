    <!-- نافذة تأكيد بدء اللعبة -->
    <div id="gameConfirmationModal" class="modal hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-play-circle"></i> تأكيد بدء اللعبة</h2>
            </div>
            <div class="modal-body">
                <div class="players-display">
                    <div class="player-side">
                        <div class="player-avatar you">
                            <i class="fas fa-user"></i>
                        </div>
                        <span class="player-label">أنت</span>
                        <span class="player-name" id="playerNameModal">اللاعب</span>
                    </div>
                    
                    <div class="vs-circle">
                        <span>VS</span>
                    </div>
                    
                    <div class="player-side">
                        <div class="player-avatar opponent">
                            <i class="fas fa-robot"></i>
                        </div>
                        <span class="player-label">الخصم</span>
                        <span class="player-name" id="opponentNameModal">الذكاء الاصطناعي</span>
                    </div>
                </div>
                
                <div class="game-info-modal">
                    <div class="game-icon-modal">
                        <i class="fas fa-snake"></i>
                    </div>
                    <div class="game-details">
                        <h3 id="selectedGameNameModal">حية والدرج</h3>
                        <p id="gameDescriptionModal">لعبة الحظ والاستراتيجية</p>
                    </div>
                </div>
            </div>
            <div class="modal-actions">
                <button id="confirmGame" class="confirm-button">
                    <i class="fas fa-play"></i> ابدأ اللعبة
                </button>
                <button id="cancelGame" class="cancel-button">
                    <i class="fas fa-times"></i> إلغاء
                </button>
            </div>
        </div>
